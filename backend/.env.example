# Copy to .env and fill in. Never commit the real .env.

SECRET_KEY=change-me-to-a-long-random-string
OPEN_CHARGE_MAP_API_KEY=

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Where the web app runs; links in emails (verify / reset password) point here.
FRONTEND_URL=http://localhost:8081

# --- Outgoing email ---------------------------------------------------------
# Leave SMTP_HOST empty in development: emails (with their links) are printed
# to the uvicorn console instead of being sent.
#
# Examples:
#   Gmail (needs 2FA + an App Password): smtp.gmail.com, 587, starttls
#   Brevo:     smtp-relay.brevo.com, 587, starttls
#   Resend:    smtp.resend.com, 465, ssl  (username "resend", password = API key)
#   SendGrid:  smtp.sendgrid.net, 587, starttls (username "apikey")
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls | ssl | none
SMTP_SECURITY=starttls
EMAIL_FROM=Road-Trip OS <no-reply@yourdomain.com>
